---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import CoverArt from '../components/CoverArt.astro';
import ScoreBadge from '../components/ScoreBadge.astro';
import Pagination from '../components/Pagination.astro';
import { listarGeneros, listarJogos } from '../lib/api';
import { carregarResumoCatalogo, lerFiltro, temFiltroAtivo, urlCom } from '../lib/filtro';
import { formatarData, matizDe } from '../lib/format';
import { ORDENACOES, PLATAFORMAS, PLATAFORMA_CURTA, PLATAFORMA_LONGA } from '../lib/labels';
import { CACHE_PAGINA_PUBLICA } from '../consts';

const BASE = '/';
const params = Astro.url.searchParams;
const filtro = lerFiltro(params);

let resultado = null;
let generos: string[] = [];
let resumo = null;
let erro = false;
try {
  [resultado, generos, resumo] = await Promise.all([listarJogos(filtro), listarGeneros(), carregarResumoCatalogo()]);
} catch {
  erro = true;
}

// Erro nunca é cacheado; a página saudável é servida da borda por alguns minutos.
if (erro) Astro.response.status = 503;
else Astro.response.headers.set('Cache-Control', CACHE_PAGINA_PUBLICA);

const comFiltro = temFiltroAtivo(filtro);
const destaque = resumo?.maisComentado ?? null;
const situacoes = [
  { valor: null, rotulo: 'Todos' },
  { valor: 'LANCADO', rotulo: 'Lançados' },
  { valor: 'EM_BREVE', rotulo: 'Em breve' },
];
---

<Layout title={comFiltro ? 'Catálogo filtrado' : undefined} noindex={comFiltro || (resultado?.pagina ?? 0) > 0}>
  <h1 class="sr-only">Catálogo de jogos de 2026: requisitos, online, DLCs e patches</h1>

  <!-- Bento: destaque + blocos de números -->
  {
    resumo && (
      <section class="container-x bento" aria-label="Destaques">
        {destaque && (
          <a href={`/jogos/${destaque.slug}`} class="destaque" style={`--hue:${matizDe(destaque.slug)}`}>
            <div class="destaque-texto">
              <span class="chip chip--cyan">Mais comentado</span>
              <h2>{destaque.nome}</h2>
              <p class="hud">
                {formatarData(destaque.dataLancamento) ?? destaque.lancamentoPrevisto ?? 'Data a definir'}
                {destaque.generos.length > 0 && <> · {destaque.generos.slice(0, 2).join(' · ')}</>}
              </p>
              <div class="destaque-chips">
                {destaque.plataformas.map((p) => <span class="chip">{PLATAFORMA_LONGA[p]}</span>)}
                {destaque.avaliacaoPercentual !== null && <ScoreBadge percentual={destaque.avaliacaoPercentual} />}
              </div>
              <span class="btn btn--primary">Ver ficha completa →</span>
            </div>
            <div class="destaque-capa">
              <CoverArt slug={destaque.slug} nome={destaque.nome} capaUrl={destaque.capaUrl} prioridade />
            </div>
          </a>
        )}

        <a href={urlCom(BASE, params, { status: null })} class="bloco panel">
          <span class="hud">No catálogo</span>
          <b>{resumo.total}</b>
          <small>jogos de 2026</small>
        </a>
        <a href={urlCom(BASE, params, { status: 'LANCADO' })} class="bloco panel">
          <span class="hud">Já lançados</span>
          <b>{resumo.lancados}</b>
          <small>com ficha completa</small>
        </a>
        <a href={urlCom(BASE, params, { status: 'EM_BREVE' })} class="bloco panel">
          <span class="hud">Em breve</span>
          <b>{resumo.emBreve}</b>
          <small>anunciados</small>
        </a>
        {resumo.melhorAvaliado && (
          <a href={`/jogos/${resumo.melhorAvaliado.slug}`} class="bloco panel">
            <span class="hud">Melhor aprovação</span>
            <b class="verde">{resumo.melhorAvaliado.avaliacaoPercentual}%</b>
            <small>{resumo.melhorAvaliado.nome}</small>
          </a>
        )}
      </section>
    )
  }

  <!-- Busca -->
  <section class="container-x busca-linha">
    <form method="get" action={BASE} id="filtros" class="busca-form" role="search">
      {filtro.plataforma && <input type="hidden" name="plataforma" value={filtro.plataforma} />}
      {filtro.status && <input type="hidden" name="status" value={filtro.status} />}
      <label class="busca">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input type="search" name="busca" value={filtro.busca ?? ''} placeholder="Buscar pelo nome do jogo…" aria-label="Buscar jogo pelo nome" autocomplete="off" />
      </label>
      <select name="genero" aria-label="Gênero">
        <option value="">Todos os gêneros</option>
        {generos.map((g) => <option value={g} selected={filtro.genero === g}>{g}</option>)}
      </select>
      <select name="ordenacao" aria-label="Ordenar por">
        {ORDENACOES.map((o) => <option value={o.valor} selected={(filtro.ordenacao ?? 'RECENTES') === o.valor}>{o.rotulo}</option>)}
      </select>
      <button type="submit" class="btn btn--primary">Buscar</button>
    </form>
  </section>

  <!-- Abas roláveis: plataforma + situação -->
  <div class="faixa">
    <nav class="container-x abas" aria-label="Filtrar por plataforma e situação">
      <a href={urlCom(BASE, params, { plataforma: null })} class:list={['aba', { ativa: !filtro.plataforma }]}>Todas</a>
      {
        PLATAFORMAS.map((p) => (
          <a href={urlCom(BASE, params, { plataforma: p })} class:list={['aba', { ativa: filtro.plataforma === p }]}>
            {PLATAFORMA_CURTA[p]}
          </a>
        ))
      }
      <span class="divisor" aria-hidden="true"></span>
      {
        situacoes.map((s) => (
          <a href={urlCom(BASE, params, { status: s.valor })} class:list={['aba', 'aba--status', { ativa: (filtro.status ?? null) === s.valor }]}>
            {s.rotulo}
          </a>
        ))
      }
    </nav>
  </div>

  <section class="container-x lista" aria-label="Jogos">
    <div class="cabecalho-lista">
      <p class="hud">{erro ? 'Catálogo indisponível' : `${resultado?.totalElementos ?? 0} jogos encontrados`}</p>
      {comFiltro && <a href={BASE} class="hud limpar">Limpar filtros ✕</a>}
    </div>

    {
      erro ? (
        <div class="vazio panel frame">
          <p class="hud hud--accent">Erro 503</p>
          <h3>Não conseguimos carregar o catálogo agora</h3>
          <a href={Astro.url.pathname + Astro.url.search} class="btn btn--primary">Tentar de novo</a>
        </div>
      ) : resultado && resultado.conteudo.length > 0 ? (
        <>
          <ul class="grade">
            {resultado.conteudo.map((jogo, i) => (
              <li><GameCard jogo={jogo} prioridade={i < 4} /></li>
            ))}
          </ul>
          <Pagination pagina={resultado.pagina} totalPaginas={resultado.totalPaginas} parametros={params} base={BASE} />
        </>
      ) : (
        <div class="vazio panel frame">
          <p class="hud hud--accent">Nenhum resultado</p>
          <h3>Nenhum jogo com esses filtros</h3>
          <a href={BASE} class="btn">Limpar filtros</a>
        </div>
      )
    }
  </section>
</Layout>

<style>
  /* ── Bento ── */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    padding-block: 32px 8px;
  }
  .destaque {
    grid-column: 1 / -1;
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: center;
    padding: 26px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, hsl(var(--hue) 90% 60%) 45%, var(--line));
    background:
      radial-gradient(ellipse 70% 120% at 100% 0%, hsl(var(--hue) 85% 50% / 0.35), transparent 65%),
      radial-gradient(ellipse 60% 100% at 0% 100%, hsl(calc(var(--hue) + 60) 80% 45% / 0.22), transparent 65%),
      var(--panel);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s;
  }
  .destaque:hover {
    transform: translateY(-3px);
    box-shadow:
      var(--shadow-card),
      0 24px 50px -24px hsl(var(--hue) 90% 60%);
  }
  .destaque-texto {
    display: grid;
    gap: 14px;
    justify-items: start;
    order: 2;
  }
  .destaque h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
  }
  .destaque .hud {
    margin: 0;
  }
  .destaque-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .destaque-capa {
    order: 1;
    width: min(150px, 42%);
    transform: rotate(-3deg);
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.5));
  }
  .bloco {
    display: grid;
    align-content: space-between;
    gap: 6px;
    min-height: 118px;
    padding: 16px 18px;
    transition:
      border-color 0.2s,
      transform 0.3s var(--ease);
  }
  .bloco:hover {
    transform: translateY(-2px);
    border-color: var(--cyan);
  }
  .bloco b {
    font-family: var(--font-mono);
    font-size: 34px;
    line-height: 1;
    background: linear-gradient(100deg, var(--cyan), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bloco b.verde {
    background: none;
    color: var(--ok);
  }
  .bloco small {
    color: var(--muted);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .bento {
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: repeat(2, minmax(118px, auto));
    }
    .destaque {
      grid-column: 1;
      grid-row: 1 / span 2;
      grid-template-columns: 1fr auto;
      padding: 32px;
    }
    .destaque-texto {
      order: 1;
    }
    .destaque-capa {
      order: 2;
      width: 190px;
    }
  }

  /* ── Busca ── */
  .busca-linha {
    padding-block: 22px 16px;
  }
  .busca-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .busca {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 280px;
    height: 46px;
    padding: 0 16px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--panel-solid);
    color: var(--muted);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .busca:focus-within {
    border-color: var(--cyan);
    color: var(--cyan);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cyan) 20%, transparent);
  }
  .busca input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
  }
  select {
    height: 46px;
    padding: 0 12px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--panel-solid);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  select:focus {
    outline: 0;
    border-color: var(--cyan);
  }
  .busca-form .btn {
    height: 46px;
  }

  /* ── Abas ── */
  .faixa {
    position: sticky;
    top: 64px;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(16px) saturate(1.4);
    border-block: 1px solid var(--line);
  }
  .abas {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-block: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .abas::-webkit-scrollbar {
    display: none;
  }
  .aba {
    flex: none;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-soft);
    transition: all 0.2s;
  }
  .aba:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .aba.ativa {
    color: var(--on-accent);
    border-color: transparent;
    background: linear-gradient(100deg, var(--cyan), var(--violet));
  }
  .divisor {
    flex: none;
    width: 1px;
    height: 22px;
    margin-inline: 8px;
    background: var(--line-strong);
  }

  /* ── Lista ── */
  .lista {
    padding-top: 22px;
  }
  .cabecalho-lista {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .cabecalho-lista .hud {
    margin: 0;
  }
  .limpar {
    color: var(--ruim);
  }
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .grade > li {
    display: flex;
  }
  .grade :global(.card) {
    flex: 1;
  }
  @media (min-width: 900px) {
    .grade {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 24px;
    }
  }
  .vazio {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding: 32px;
  }
</style>

<script>
  const formulario = document.getElementById('filtros') as HTMLFormElement | null;
  formulario?.addEventListener('change', (evento) => {
    if ((evento.target as HTMLElement).matches('select')) formulario.requestSubmit();
  });
</script>
