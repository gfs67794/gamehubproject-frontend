---
import type { FiltroListagem, Plataforma, StatusJogo } from '../types/api';
import { AVALIACOES_MINIMAS, ORDENACOES, PLATAFORMAS, PLATAFORMA_CURTA } from '../lib/labels';

interface Props {
  filtro: FiltroListagem;
  generos: string[];
}

const { filtro, generos } = Astro.props;

const plataformas: { valor: Plataforma | ''; rotulo: string }[] = [
  { valor: '', rotulo: 'Todas' },
  ...PLATAFORMAS.map((valor) => ({ valor, rotulo: PLATAFORMA_CURTA[valor] })),
];
const situacoes: { valor: StatusJogo | ''; rotulo: string }[] = [
  { valor: '', rotulo: 'Todos' },
  { valor: 'LANCADO', rotulo: 'Lançados' },
  { valor: 'EM_BREVE', rotulo: 'Em breve' },
];

const filtrosAtivos = Boolean(
  filtro.busca || filtro.plataforma || filtro.status || filtro.genero || filtro.avaliacaoMinima,
);
---

<form method="get" action="/" class="filtros panel" id="filtros" role="search">
  <div class="busca">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input type="search" name="busca" value={filtro.busca ?? ''} placeholder="Buscar jogo pelo nome…" aria-label="Buscar jogo pelo nome" autocomplete="off" />
    <button type="submit" class="btn btn--primary">Buscar</button>
  </div>

  <fieldset class="grupo">
    <legend class="hud">Plataforma</legend>
    <div class="pills">
      {
        plataformas.map((item) => (
          <label class="pill">
            <input type="radio" name="plataforma" value={item.valor} checked={(filtro.plataforma ?? '') === item.valor} />
            <span>{item.rotulo}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="linha">
    <fieldset class="grupo">
      <legend class="hud">Situação</legend>
      <div class="pills">
        {
          situacoes.map((item) => (
            <label class="pill">
              <input type="radio" name="status" value={item.valor} checked={(filtro.status ?? '') === item.valor} />
              <span>{item.rotulo}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="campo">
      <span class="hud">Gênero</span>
      <select name="genero">
        <option value="">Todos</option>
        {generos.map((genero) => <option value={genero} selected={filtro.genero === genero}>{genero}</option>)}
      </select>
    </label>

    <label class="campo">
      <span class="hud">Aprovação mínima</span>
      <select name="avaliacaoMinima">
        <option value="">Qualquer</option>
        {AVALIACOES_MINIMAS.map((minima) => <option value={minima} selected={filtro.avaliacaoMinima === minima}>{minima}%+</option>)}
      </select>
    </label>

    <label class="campo">
      <span class="hud">Ordenar por</span>
      <select name="ordenacao">
        {ORDENACOES.map((item) => <option value={item.valor} selected={(filtro.ordenacao ?? 'RECENTES') === item.valor}>{item.rotulo}</option>)}
      </select>
    </label>

    {filtrosAtivos && <a href="/" class="limpar hud">Limpar filtros ✕</a>}
  </div>
</form>

<style>
  .filtros {
    display: grid;
    gap: 18px;
    padding: 20px;
  }
  .busca {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 6px 6px 14px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--panel-solid);
    color: var(--muted);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .busca:focus-within {
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--cyan) 20%, transparent);
    color: var(--cyan);
  }
  .busca input {
    flex: 1;
    min-width: 0;
    height: 38px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
  }
  .busca input::placeholder {
    color: var(--muted);
  }
  .busca .btn {
    height: 38px;
  }
  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .pill {
    position: relative;
    cursor: pointer;
  }
  .pill input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .pill span {
    display: inline-block;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text-soft);
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
  }
  .pill:hover span {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .pill input:checked + span {
    color: var(--on-accent);
    border-color: transparent;
    background: linear-gradient(100deg, var(--cyan), var(--violet));
    box-shadow: 0 6px 18px -8px var(--cyan);
  }
  .pill input:focus-visible + span {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  .linha {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    align-items: flex-end;
  }
  .campo {
    display: grid;
    gap: 6px;
    min-width: 150px;
  }
  select {
    height: 38px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--panel-solid);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  select:focus {
    outline: 0;
    border-color: var(--cyan);
  }
  .limpar {
    margin-left: auto;
    align-self: center;
    padding: 8px 4px;
    color: var(--ruim);
  }
  .limpar:hover {
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .filtros {
      padding: 14px;
    }
    .campo {
      flex: 1 1 140px;
    }
  }
</style>

<script>
  // Aplica o filtro assim que o usuário troca uma opção (sem JS, o botão "Buscar" continua funcionando).
  const formulario = document.getElementById('filtros') as HTMLFormElement | null;
  formulario?.addEventListener('change', (evento) => {
    if ((evento.target as HTMLElement).matches('input[type="radio"], select')) formulario.requestSubmit();
  });
</script>
