---
import type { JogoResumo } from '../types/api';
import CoverArt from './CoverArt.astro';
import ScoreBadge from './ScoreBadge.astro';
import { formatarData } from '../lib/format';
import { PLATAFORMA_CURTA } from '../lib/labels';

interface Props {
  jogo: JogoResumo;
  prioridade?: boolean;
}

const { jogo, prioridade = false } = Astro.props;
const MAX_PLATAFORMAS = 4;

const data = formatarData(jogo.dataLancamento) ?? jogo.lancamentoPrevisto ?? 'Data a definir';
const plataformas = jogo.plataformas.slice(0, MAX_PLATAFORMAS);
const restantes = jogo.plataformas.length - plataformas.length;
---

<a href={`/jogos/${jogo.slug}`} class="card">
  <div class="moldura">
    <CoverArt slug={jogo.slug} nome={jogo.nome} capaUrl={jogo.capaUrl} prioridade={prioridade} />
    <div class="sobre">
      {jogo.status === 'EM_BREVE' ? <span class="chip chip--violet">Em breve</span> : <span></span>}
      {jogo.avaliacaoPercentual !== null && <ScoreBadge percentual={jogo.avaliacaoPercentual} />}
    </div>
  </div>

  <div class="corpo">
    <h3>{jogo.nome}</h3>
    <p class="hud data">{data}</p>
    <div class="plataformas">
      {plataformas.map((p) => <span class="chip">{PLATAFORMA_CURTA[p]}</span>)}
      {restantes > 0 && <span class="chip">+{restantes}</span>}
    </div>
    {jogo.generos.length > 0 && <p class="generos">{jogo.generos.slice(0, 2).join(' · ')}</p>}
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 10px 10px 16px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--panel);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.35s var(--ease),
      border-color 0.25s,
      box-shadow 0.35s;
  }
  .card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--cyan) 60%, transparent);
    box-shadow:
      var(--shadow-card),
      0 18px 40px -18px var(--cyan),
      0 0 0 1px color-mix(in srgb, var(--cyan) 25%, transparent);
  }
  .moldura {
    position: relative;
  }
  .sobre {
    position: absolute;
    inset: 8px 8px auto 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
  }
  .corpo {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-inline: 6px;
  }
  h3 {
    font-size: 17px;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .data {
    margin: 0;
  }
  .plataformas {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .plataformas .chip {
    padding: 1px 8px;
    font-size: 10.5px;
  }
  .generos {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
