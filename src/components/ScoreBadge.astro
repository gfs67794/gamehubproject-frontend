---
import { tomDaAvaliacao } from '../lib/labels';

interface Props {
  percentual: number;
}

const { percentual } = Astro.props;
const tom = tomDaAvaliacao(percentual);
---

<span class:list={['nota', `tom-${tom}`]} title="Aprovação dos jogadores">
  <b>{percentual}</b><small>%</small>
</span>

<style>
  .nota {
    display: inline-flex;
    align-items: baseline;
    gap: 1px;
    padding: 3px 9px;
    border-radius: 8px;
    font-family: var(--font-mono);
    line-height: 1.4;
    background: rgba(5, 7, 12, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--tom) 55%, transparent);
    box-shadow: 0 0 14px -4px var(--tom);
  }
  b {
    font-size: 14px;
    font-weight: 700;
  }
  small {
    font-size: 10px;
    opacity: 0.8;
  }
</style>
